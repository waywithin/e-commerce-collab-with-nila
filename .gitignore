/uploads/products/*
/uploads/providers/*

# Local database exports, backups, and application logs
/*.sql.gz
/*.dump
/*.bak
*.log

# Private key and certificate bundles
*.pem
*.key
*.p12
*.pfx

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
